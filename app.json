{
  "expo": {
    "name": "Sawfy White Dried Catfish",
    "slug": "herspew",
    "version": "1.0.0",
    "scheme": "sawfywhite",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAF8F5",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sawfywhite.mobile"
    },
    "android": {
      "package": "com.sawfywhite.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "androidNavigationBar": {
      "visible": "always",
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "f36bd748-51bd-4710-8762-5e78ef3cd1e4"
      }
    }
  }
}
